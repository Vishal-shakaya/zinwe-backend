# Copy to .env and adjust. Every value has a safe local default, so .env is optional for local dev.

# INSECURE default is used when unset. ALWAYS set a long random value outside local dev.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated origins allowed to call the API from a browser (Vite dev server by default).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Set to True only when running behind a trusted reverse proxy that sets X-Forwarded-For.
ZINWE_TRUST_X_FORWARDED_FOR=False

# Email. Console backend prints mail to the runserver terminal.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=Zinwe <hello@zinwe.io>
ZINWE_TEAM_NOTIFY_EMAIL=hello@zinwe.io
# For SMTP, set EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend and:
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True

# ASGI server (manage.py serve -> uvicorn config.asgi:application)
ZINWE_ASGI_HOST=127.0.0.1
ZINWE_ASGI_PORT=8000
# Worker processes; ignored while reload is on. Reload defaults to DJANGO_DEBUG.
ZINWE_ASGI_WORKERS=1
# ZINWE_ASGI_RELOAD=True
ZINWE_ASGI_LOG_LEVEL=info
# Proxy IPs whose X-Forwarded-* headers uvicorn trusts (only when ZINWE_TRUST_X_FORWARDED_FOR=True).
ZINWE_FORWARDED_ALLOW_IPS=127.0.0.1
