# Copy to .env and adjust. Every value has a safe local default, so .env is optional for local dev.

# INSECURE default is used when unset. ALWAYS set a long random value outside local dev.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated origins allowed to call the API from a browser (Vite dev server by default).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Set to True only when running behind a trusted reverse proxy that sets X-Forwarded-For.
ZINWE_TRUST_X_FORWARDED_FOR=False

# Email. Console backend prints mail to the runserver terminal.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=Zinwe <hello@zinwe.io>
ZINWE_TEAM_NOTIFY_EMAIL=hello@zinwe.io
# Customer site, used for links in emails (prod: https://zinwe.io)
ZINWE_APP_URL=http://localhost:5173
# For SMTP, set EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend and:
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
# End-to-end runs: EMAIL_BACKEND=django.core.mail.backends.filebased.EmailBackend writes each email
# as a file in EMAIL_FILE_PATH (default <project>/sent-emails, gitignored), so OTPs can be read back.
# EMAIL_FILE_PATH=

# Uploads (payment proofs). Never served publicly. Default: <project>/media
# DJANGO_MEDIA_ROOT=

# Optional, once deployed: the logo image at the top of emails (default: the wordmark in text)
# ZINWE_EMAIL_LOGO_URL=https://zinwe.io/brand/zinwe-logo-96.png

# Manual payment instructions shown on the subscribe page. Put the real values in .env only
# (never commit them); empty values are shown as blank.
ZINWE_PAYMENT_UPI_ID=
ZINWE_PAYMENT_PAYEE_NAME=SKYTECHNO
ZINWE_PAYMENT_BANK_NAME=
# e.g. Current or Savings
ZINWE_PAYMENT_ACCOUNT_TYPE=
ZINWE_PAYMENT_ACCOUNT_NUMBER=
ZINWE_PAYMENT_IFSC=
# PayPal link for payments from outside India (e.g. https://paypal.me/<name>). Only shown while no
# Skydo account is set below. Empty hides PayPal.
ZINWE_PAYMENT_PAYPAL_URL=

# GST (z_auth/pricing.py). GST is charged to customers in India only when the GSTIN is set:
# CGST 9% + SGST 9% in the seller's state, IGST 18% elsewhere. Outside India: USD, no GST (export
# under LUT; put the LUT ARN here so it prints on export invoices).
ZINWE_INVOICE_SELLER_NAME=SKYTECHNO
ZINWE_INVOICE_SELLER_ADDRESS=New Delhi, India
ZINWE_INVOICE_SELLER_GSTIN=
ZINWE_GST_SELLER_STATE=Delhi
ZINWE_GST_SAC=998314
ZINWE_GST_LUT_ARN=

# Skydo US account for customers outside India (ACH / wire). Empty hides it. A per-customer Skydo
# payment link (card / US bank) is set in the admin app: Subscriptions -> Add payment link.
ZINWE_SKYDO_ACCOUNT_NAME=
ZINWE_SKYDO_BANK_NAME=
ZINWE_SKYDO_ACCOUNT_NUMBER=
ZINWE_SKYDO_ROUTING_NUMBER=
ZINWE_SKYDO_ACCOUNT_TYPE=Checking
ZINWE_SKYDO_SWIFT=
# The general Skydo payment page (https), used when a customer has no payment link of their own.
ZINWE_SKYDO_PAYMENT_URL=
# ZINWE_PAYMENT_NOTE=Use your company name as the payment reference.

# ASGI server (manage.py serve -> uvicorn config.asgi:application)
ZINWE_ASGI_HOST=127.0.0.1
ZINWE_ASGI_PORT=8000
# Worker processes; ignored while reload is on. Reload defaults to DJANGO_DEBUG.
ZINWE_ASGI_WORKERS=1
# ZINWE_ASGI_RELOAD=True
ZINWE_ASGI_LOG_LEVEL=info
# Proxy IPs whose X-Forwarded-* headers uvicorn trusts (only when ZINWE_TRUST_X_FORWARDED_FOR=True).
ZINWE_FORWARDED_ALLOW_IPS=127.0.0.1

# --- Deployments (set by .cloude/dev-ops-agent on the server; leave unset locally) ---
# PostgreSQL is used when DB_NAME is set; otherwise SQLite (db.sqlite3).
# DB_NAME=zinwe_dev
# DB_USER=zinwe_dev
# DB_PASSWORD=
# DB_HOST=127.0.0.1
# DB_PORT=5432
# Comma-separated origins allowed to POST forms (admin login) when served from a public host.
# DJANGO_CSRF_TRUSTED_ORIGINS=https://dev.zinwe.io
# Turn on once nginx serves HTTPS: secure cookies + trust X-Forwarded-Proto. HSTS stays 0 until the domain is final.
# DJANGO_HTTPS=False
# DJANGO_HSTS_SECONDS=0

# Web push: browser notifications with the dashboard closed (z_devices/web_push.py). All three, or it stays off and the
# open dashboard's 30-second poll works as before. One key pair per server, made once: changing it makes every browser
# subscribe again. Put the real values in .env only.
# Public: base64url, what the browser subscribes with. Private: base64url, never leaves the server.
WEBPUSH_VAPID_PUBLIC_KEY=
WEBPUSH_VAPID_PRIVATE_KEY=
# A mailto: or https: address the push services can reach us at, e.g. mailto:hello@zinwe.io
WEBPUSH_VAPID_SUBJECT=

# Website lists: where the weekly rebuild publishes, outside the release. The servers set this themselves
# (zinwe-server units); leave it empty on a developer PC.
ZINWE_BLOCKLIST_DIR=
